# Bybit API Credentials
# ───────────────────────
# Option A: Bybit Demo Trading (created on https://www.bybit.com under Demo Trading)
# Set BYBIT_DEMO=true
BYBIT_DEMO=true
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Option B: Bybit Testnet (created on https://testnet.bybit.com)
# Set BYBIT_DEMO=false
# BYBIT_DEMO=false
# BYBIT_TESTNET_API_KEY=your_testnet_api_key_here
# BYBIT_TESTNET_API_SECRET=your_testnet_api_secret_here
